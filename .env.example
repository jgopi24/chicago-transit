# CTA developer keys (free) — https://www.transitchicago.com/developers/
CTA_BUS_API_KEY=
CTA_TRAIN_API_KEY=

# Shared secret gating the connector API (the "custom.cta" API key).
# Widgets and the CLI send it as X-API-Key. Leave empty to disable auth (dev only).
CONNECTOR_API_KEY=

# Poll cadence (seconds)
POLL_VEHICLES_SEC=30
POLL_ALERTS_SEC=120

PORT=8000
